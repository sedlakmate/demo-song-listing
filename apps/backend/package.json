{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "build": "tsc && mkdir -p dist/api-routes && cp -v src/api-routes/openapi.yaml dist/api-routes/openapi.yaml && echo 'Build complete. Verifying openapi.yaml...' && ls -la dist/api-routes/",
    "clean": "rm -rf dist",
    "dev": "nodemon --exec ts-node ./src/index.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "type-check": "yarn tsc --noEmit",
    "start": "ts-node ./src/index.ts",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@repo/jest-presets/dist"
  },
  "dependencies": {
    "@repo/logger": "*",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-openapi": "^12.1.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.2.0",
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
